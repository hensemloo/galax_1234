# Copy this file to .env and adjust for your machine.
# FastAPI backend URL (Phase 2).
VITE_API_BASE_URL=http://localhost:8000
# "true" = use mock data in the browser, no backend needed (this is also the default when the
# line or the whole .env file is missing). "false" = call the real FastAPI backend.
VITE_USE_MOCK=true
